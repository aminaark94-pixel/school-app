# Notification Gateway Server Configuration
PORT=5001

# --- Android Phone SMS Gateway Configuration ---
# Option 1: TextBee API (Free Android SMS Gateway: https://textbee.dev)
TEXTBEE_API_KEY=your_textbee_api_key_here
TEXTBEE_DEVICE_ID=your_device_id_here

# Option 2: Local Android SMS Gateway App (running on phone connected to local Wi-Fi)
# Example: http://192.168.1.105:8080
ANDROID_SMS_GATEWAY_URL=
